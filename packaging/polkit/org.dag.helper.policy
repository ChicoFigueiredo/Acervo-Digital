<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>DAG - Disk Archive Cataloger</vendor>
  <vendor_url>https://github.com/ChicoFigueiredo/Acervo-Digital</vendor_url>

  <action id="org.dag.helper.ler-metadados">
    <description>Read file metadata in protected folders</description>
    <description xml:lang="pt_BR">Ler metadados de arquivos em pastas protegidas</description>
    <message>Authentication is required to let DAG read the names, sizes and dates (never the contents) of files in a protected folder</message>
    <message xml:lang="pt_BR">E necessario autenticar para o DAG ler nomes, tamanhos e datas (nunca o conteudo) de arquivos em uma pasta protegida</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/dag/dag-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">false</annotate>
  </action>
</policyconfig>
